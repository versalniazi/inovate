# ─────────────────────────────────────────────────────────────
# INOVATE LTD website — environment variables
# Copy to .env.local for local development. On Vercel, add these in
# Project → Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public URL of the live site (no trailing slash). Used for canonical URLs,
# the sitemap, Open Graph tags and structured data.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.co.uk

# ── Contact form email delivery (server-side only) ──────────
# EMAIL_SERVICE: "smtp" to send real email, or "console" to log enquiries
# to the server output (useful in local development).
EMAIL_SERVICE=console
# The "From" address. Must be an address your SMTP provider allows you to send as.
EMAIL_FROM="INOVATE Website <no-reply@your-domain.co.uk>"
# Where enquiries are delivered.
EMAIL_TO=0004manzar@gmail.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Analytics (optional — leave blank to disable) ───────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
ANALYTICS_ID=
# Meta (Facebook) Pixel ID
META_PIXEL_ID=
# Google Search Console HTML-tag verification token (content value only)
GOOGLE_SITE_VERIFICATION=
